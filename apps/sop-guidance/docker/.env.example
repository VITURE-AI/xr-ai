# Copy to .env next to compose.yaml. .env is git-ignored; never commit keys.

# Hosted DashScope models (LLM, VLM, speech).
DASHSCOPE_API_KEY=
# Optional: another DashScope region endpoint.
# DASHSCOPE_API_URL=

# Optional bearer secret the UI's server sends to the worker's app API.
# SOP_GUIDANCE_API_TOKEN=

# Optional passcode for the hub's web client.
# XR_WEB_PASSCODE=

# Build mirrors (for example inside mainland China):
# APT_MIRROR_HOST=mirrors.aliyun.com
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# TORCH_INDEX_URL=https://mirrors.nju.edu.cn/pytorch/whl/cpu
