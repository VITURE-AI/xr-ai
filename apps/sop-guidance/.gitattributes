# Detector weights are binary and several MB each: keep them in Git LFS.
# (The directory is `detectors/`, not `models/`, because the root .gitignore
# ignores `**/models/**`.)
detectors/**/*.bin filter=lfs diff=lfs merge=lfs -text
detectors/**/*.xml filter=lfs diff=lfs merge=lfs -text
detectors/**/*.pt filter=lfs diff=lfs merge=lfs -text
